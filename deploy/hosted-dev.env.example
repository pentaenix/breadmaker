# Developer-only hosted runtime.
BREADMAKER_RUNTIME=hosted_dev
# Manual private development keeps the 9.5 fixed identity:
BREADMAKER_AUTH_MODE=developer
BREADMAKER_HOSTED_DEV_ALLOW_UNAUTHENTICATED=1
BREADMAKER_HOSTED_DEV_NAME=Developer
# `developer` is rejected when BREADMAKER_ENV=production, even with the opt-in above.
# Public deployments must use authenticated session mode rather than this fixed identity.
# Mount durable storage at /data when using the hosted-dev container.
BREADMAKER_HOME=/data

# Automated hosted-session testing instead uses:
# BREADMAKER_AUTH_MODE=test
# BREADMAKER_ENV=test
# BREADMAKER_TEST_AUTH_SECRET=<at least 32 random characters>
# BREADMAKER_SESSION_COOKIE_SECURE=0   # test-only HTTP harness

# Hosted resource limits are optional; defaults are documented in deploy/HOSTED_DEV.md.
# BREADMAKER_HOSTED_MAX_PROJECTS_PER_OWNER=25
# BREADMAKER_HOSTED_MAX_OWNER_BYTES=8589934592
# BREADMAKER_HOSTED_MAX_PROJECT_BYTES=2147483648
# BREADMAKER_HOSTED_WRITES_PER_MINUTE=600
# BREADMAKER_HOSTED_HEAVY_PER_MINUTE=30
