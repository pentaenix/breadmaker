# Source-bound vendor runtime; local accountless distribution is unchanged.
ARG PYTHON_BASE_DIGEST
FROM cgr.dev/chainguard/wolfi-base@sha256:${PYTHON_BASE_DIGEST} AS build
ARG PYTHON_BASE_DIGEST
RUN apk add --no-cache python-3.14=3.14.10_git20261104-r0 python-3.14-dev=3.14.10_git20261104-r0 py3.14-pip build-base
WORKDIR /app
COPY deploy/sqlite-source.json deploy/vendor-runtime.json ./deploy/
COPY scripts/build_hosted_sqlite.py scripts/assert_hosted_sqlite.py scripts/stage_vendor_runtime.py scripts/assert_vendor_runtime.py ./scripts/
RUN python3.14 scripts/build_hosted_sqlite.py --package-format none
COPY requirements.txt requirements-hosted.txt ./
COPY deploy/constraints-hosted.txt ./deploy/constraints-hosted.txt
RUN python3.14 -m venv --without-pip /opt/python && python3.14 -m pip --python /opt/python/bin/python install --no-cache-dir -r requirements-hosted.txt -c deploy/constraints-hosted.txt setuptools==84.2.0
ENV PATH=/opt/python/bin:$PATH
# Explicit source allowlist: no credentials, databases or private local state.
COPY src ./src
COPY static ./static
COPY locales ./locales
COPY config ./config
COPY docs/HOSTED_DATA_MODEL_V1.json ./docs/HOSTED_DATA_MODEL_V1.json
COPY VERSION ./VERSION
COPY scripts/assert_hosted_image_stack.py ./scripts/assert_hosted_image_stack.py
RUN python scripts/assert_hosted_image_stack.py
RUN python -c "from pathlib import Path; p=Path('static/vendor/narration'); assert not any(f.suffix in {'.onnx','.bin','.wasm'} or 'models' in f.relative_to(p).parts or 'dictionaries' in f.relative_to(p).parts for f in p.rglob('*') if f.is_file()), 'NARRATION_BINARY_IN_APP_IMAGE'"
RUN python scripts/stage_vendor_runtime.py --install --mode hosted --base-digest "$PYTHON_BASE_DIGEST"
FROM scratch
COPY --from=build /runtime/ /
COPY --from=build /opt/python /opt/python
COPY --from=build /app /app
WORKDIR /app
ENV PATH=/opt/python/bin:/usr/bin LD_LIBRARY_PATH=/opt/python-libs HOME=/nonexistent

ENV PYTHONPATH=/app/src \
    BREADMAKER_RUNTIME=hosted \
    BREADMAKER_AUTH_MODE=identity_platform \
    BREADMAKER_ENV=staging \
    BREADMAKER_UVICORN_NO_ACCESS_LOG=1 \
    BREADMAKER_ENFORCE_PUBLIC_HOST=1 \
    BREADMAKER_WORKERS=1 \
    TMPDIR=/tmp \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080
USER 10001:10001
RUN ["python","scripts/assert_vendor_runtime.py","--mode","hosted"]
RUN ["python", "-c", "import ssl,sqlite3,bz2,lzma,ctypes,uuid; import firebase_admin,google.cloud.firestore,google.cloud.storage,docx,reportlab,PIL,uvicorn"]
RUN ["python", "-c", "import importlib.util; assert importlib.util.find_spec('pip') is None; assert importlib.util.find_spec('ensurepip') is None"]
RUN ["python", "scripts/assert_hosted_image_stack.py"]
RUN ["python", "-c", "from hosted.local_portability import _mapping; assert _mapping()"]
RUN ["python", "scripts/assert_hosted_sqlite.py"]

# One worker is a cost/memory default, not a security or project-write lock.
# A Cloud Run replica can disappear at any point; Uvicorn handles SIGTERM and the
# FastAPI hosted lifespan owns no persistent in-process work to flush.
CMD ["python", "-m", "uvicorn", "src.server:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--timeout-graceful-shutdown", "8", "--no-access-log", "--no-proxy-headers", "--no-server-header"]
