# The approved OCI build base and authenticated runtime graph are source-bound.
ARG PYTHON_BASE_DIGEST
FROM cgr.dev/chainguard/wolfi-base@sha256:${PYTHON_BASE_DIGEST} AS build
ARG PYTHON_BASE_DIGEST
RUN apk add --no-cache python-3.14=3.14.10_git20261104-r0 python-3.14-dev=3.14.10_git20261104-r0 py3.14-pip build-base
WORKDIR /helper
COPY deploy/requirements-pronunciation.txt ./requirements.txt
COPY deploy/vendor-runtime.json ./deploy/vendor-runtime.json
COPY scripts/stage_vendor_runtime.py scripts/assert_vendor_runtime.py ./scripts/
RUN python3.14 -m venv --without-pip /opt/python && python3.14 -m pip --python /opt/python/bin/python install --no-cache-dir -r requirements.txt setuptools==84.2.0
ENV PATH=/opt/python/bin:$PATH PYTHONPATH=/helper/src
COPY src/narration ./src/narration
COPY src/hosted/narration/pronunciation_helper.py ./src/hosted/narration/pronunciation_helper.py
COPY tools/narration/assert-helper-data.py tools/narration/build-helper-lexicon.py tools/narration/language-data-pins.json tools/narration/THIRD_PARTY_NOTICES.md ./notices/
RUN python notices/assert-helper-data.py --isolated-image && python notices/build-helper-lexicon.py
RUN python -c "import gruut_lang_it,shutil; from pathlib import Path; shutil.rmtree(Path(gruut_lang_it.__file__).parent/'espeak')"
RUN python scripts/stage_vendor_runtime.py --install --mode helper --base-digest "$PYTHON_BASE_DIGEST"

# Copy only the assembled runtime, never compiler, shell or package manager code.
FROM scratch
COPY --from=build /runtime/ /
COPY --from=build /opt/python /opt/python
COPY --from=build /helper /helper
WORKDIR /helper
ENV PATH=/opt/python/bin:/usr/bin HOME=/nonexistent PYTHONPATH=/helper/src PYTHONDONTWRITEBYTECODE=1 TMPDIR=/tmp
USER 10001:10001
RUN ["python","scripts/assert_vendor_runtime.py","--mode","helper"]
RUN ["python","notices/assert-helper-data.py","--isolated-image"]
RUN ["python","-c","import ssl,pycrfsuite,fugashi,mojimoji; from hosted.narration.pronunciation_helper import app"]
EXPOSE 8080
CMD ["python","-m","uvicorn","hosted.narration.pronunciation_helper:app","--host","0.0.0.0","--port","8080","--workers","1","--timeout-graceful-shutdown","8","--no-access-log","--no-proxy-headers","--no-server-header"]
