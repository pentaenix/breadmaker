#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
: "${BREADMAKER_GCP_PROJECT_ID:=${GOOGLE_CLOUD_PROJECT:-}}"
: "${BREADMAKER_FIREBASE_WEB_API_KEY:?Set BREADMAKER_FIREBASE_WEB_API_KEY to the browser-restricted Firebase Web API key}"
: "${BREADMAKER_GCP_PROJECT_ID:?Set BREADMAKER_GCP_PROJECT_ID or GOOGLE_CLOUD_PROJECT}"
: "${BREADMAKER_FIREBASE_AUTH_DOMAIN:=${BREADMAKER_GCP_PROJECT_ID}.firebaseapp.com}"
PORT="${PORT:-8000}"
export BREADMAKER_RUNTIME=hosted_dev
export BREADMAKER_AUTH_MODE=identity_platform
export BREADMAKER_ENV=development
export BREADMAKER_GCP_PROJECT_ID BREADMAKER_FIREBASE_WEB_API_KEY BREADMAKER_FIREBASE_AUTH_DOMAIN
export BREADMAKER_PUBLIC_ORIGIN="http://127.0.0.1:${PORT}"
export BREADMAKER_SESSION_COOKIE_SECURE=0
export BREADMAKER_IDENTITY_GOOGLE_ENABLED="${BREADMAKER_IDENTITY_GOOGLE_ENABLED:-1}"
export BREADMAKER_IDENTITY_APPLE_ENABLED="${BREADMAKER_IDENTITY_APPLE_ENABLED:-0}"
exec ./run-hosted-dev --host 127.0.0.1 --port "$PORT"
