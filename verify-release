#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"
# If dependency/toolchain preflight aborts before the Python verifier,
# still finish by printing the exact source version. Successful runs
# exec the Python verifier, which prints its own final version footer.
early_failure_version() {
  status=$?
  if [ "$status" -ne 0 ]; then
    printf 'Verification target: Breadmaker Editor v%s\n' "$(tr -d '\r\n' < VERSION)" >&2
  fi
}
trap early_failure_version EXIT
select_python(){
  if [ -n "${PYTHON:-}" ] && "$PYTHON" - <<'PYCHECK' >/dev/null 2>&1
import sys
assert sys.version_info >= (3, 10)
PYCHECK
  then
    printf '%s\n' "$PYTHON"
    return 0
  fi
  for candidate in python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" - <<'PYCHECK' >/dev/null 2>&1
import sys
assert sys.version_info >= (3, 10)
PYCHECK
    then
      command -v "$candidate"
      return 0
    fi
  done
  return 1
}

python_supported(){
  [ -x "$1" ] && "$1" - <<'PYCHECK' >/dev/null 2>&1
import sys
assert sys.version_info >= (3, 10)
PYCHECK
}

has_test_deps(){
  "$1" - <<'PYCHECK' >/dev/null 2>&1
import importlib.metadata as m, pathlib, re

def exact_requirements(path, seen=None):
    path=pathlib.Path(path).resolve()
    seen=set() if seen is None else seen
    if path in seen:
        return
    seen.add(path)
    for raw in path.read_text(encoding="utf-8").splitlines():
        raw=raw.strip()
        if not raw or raw.startswith("#"):
            continue
        if raw.startswith("-r "):
            exact_requirements(path.parent/raw[3:].strip(), seen)
            continue
        match=re.fullmatch(r"([A-Za-z0-9_.-]+)==([^ ]+)",raw)
        if not match:
            raise SystemExit(1)
        if m.version(match.group(1)) != match.group(2):
            raise SystemExit(1)

exact_requirements("requirements.txt")
exact_requirements("requirements-test.txt")
import fastapi, starlette, uvicorn, docx, multipart, bs4, pytest, playwright, requests, httpx, cryptography, authlib, joserfc, PIL, pip_audit
import google.auth, google.cloud.firestore, google.cloud.storage, google.cloud.kms, firebase_admin
PYCHECK
}

printf 'Preparing Breadmaker release verification...\n'
if ! SYSTEM_PYTHON="$(select_python)"; then
  printf 'Python 3.10+ is required for Breadmaker verification. Install Python 3.10+ or set PYTHON to a compatible interpreter.\n' >&2
  exit 2
fi
export PYTHON="$SYSTEM_PYTHON"
if [ -n "${BREADMAKER_TEST_PYTHON:-}" ]; then
  if ! has_test_deps "$BREADMAKER_TEST_PYTHON"; then
    printf 'BREADMAKER_TEST_PYTHON does not match the pinned verification dependency set.\n' >&2
    exit 1
  fi
  TEST_PYTHON="$BREADMAKER_TEST_PYTHON"
elif has_test_deps "$SYSTEM_PYTHON"; then
  TEST_PYTHON="$SYSTEM_PYTHON"
else
  VENV_PYTHON=".venv/bin/python"
  if [ -d .venv ] && ! python_supported "$VENV_PYTHON"; then
    printf 'Rebuilding stale verification environment with Python 3.10+...\n'
    rm -rf .venv
  fi
  if [ ! -x "$VENV_PYTHON" ]; then
    printf 'Creating isolated test environment...\n'
    "$SYSTEM_PYTHON" -m venv .venv
  fi
  if ! has_test_deps "$VENV_PYTHON"; then
    printf 'Installing verification dependencies...\n'
    "$VENV_PYTHON" -m pip install -r requirements-test.txt
  fi
  TEST_PYTHON="$VENV_PYTHON"
fi

printf 'Auditing production dependency graph for known vulnerabilities...\n'
AUDIT_OUTPUT=$(mktemp "${TMPDIR:-/tmp}/breadmaker-pip-audit.XXXXXX")
trap 'rm -f "$AUDIT_OUTPUT"' EXIT
if ! "$TEST_PYTHON" -m pip_audit --strict --progress-spinner=off --desc=off -r requirements.txt >"$AUDIT_OUTPUT" 2>&1; then
  printf 'Breadmaker dependency security audit FAILED.\n' >&2
  cat "$AUDIT_OUTPUT" >&2
  exit 1
fi
printf 'Core dependency security audit: PASS\n'

# Hosted requirements include the regular Editor requirements plus the Google SDKs.
# pip-audit resolves transitive dependencies without installing hosted services or
# requesting Google credentials. An advisory service/network failure is a hard fail.
printf 'Auditing hosted dependency graph (including Google SDKs)...\n'
if ! "$TEST_PYTHON" -m pip_audit --strict --progress-spinner=off --desc=off -r requirements-hosted.txt >"$AUDIT_OUTPUT" 2>&1; then
  printf 'Breadmaker HOSTED dependency security audit FAILED.\n' >&2
  cat "$AUDIT_OUTPUT" >&2
  exit 1
fi
printf 'Hosted dependency security audit: PASS\n'
rm -f "$AUDIT_OUTPUT"
trap - EXIT

exec "$TEST_PYTHON" scripts/verify_release.py "$@"
